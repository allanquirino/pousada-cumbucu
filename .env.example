# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (porta 6543). Obrigatório na Vercel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# demo = dados de demonstração e contas de teste (senha bosque2026) · minimal = só o administrador (exige ADMIN_PASSWORD)
SEED=demo
# ADMIN_PASSWORD=troque-por-uma-senha-forte
# Protege o agendador (Vercel Cron) que sincroniza a Booking. Gere um valor aleatório longo.
CRON_SECRET=
