{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": { "api/index.js": { "maxDuration": 30, "includeFiles": "{src/**,node_modules/@electric-sql/pglite/dist/**}" } },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/ical/(.*)", "destination": "/api" },
    { "source": "/demo/(.*)", "destination": "/api" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ],
  "crons": [{ "path": "/api/cron/ical", "schedule": "0 9 * * *" }],
  "headers": [
    { "source": "/admin/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
