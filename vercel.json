{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": { "api/[...path].js": { "maxDuration": 30, "includeFiles": "src/**" } },
  "rewrites": [
    { "source": "/ical/:path*", "destination": "/api/ical/:path*" },
    { "source": "/demo/:path*", "destination": "/api/demo/:path*" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ],
  "crons": [{ "path": "/api/cron/ical", "schedule": "0 9 * * *" }],
  "headers": [
    { "source": "/admin/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
